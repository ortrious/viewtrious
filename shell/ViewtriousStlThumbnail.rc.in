#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_COMMAS@
 PRODUCTVERSION @PROJECT_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "viewtrious"
            VALUE "FileDescription", "viewtrious STL thumbnail provider"
            VALUE "FileVersion", "@VIEWTRIOUS_WINDOWS_VERSION@"
            VALUE "InternalName", "ViewtriousStlThumbnail"
            VALUE "OriginalFilename", "ViewtriousStlThumbnail.dll"
            VALUE "ProductName", "viewtrious"
            VALUE "ProductVersion", "@VIEWTRIOUS_WINDOWS_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
