#include <windows.h>

#define IDI_VIEWTRIOUS 101
#define IDR_VIEWTRIOUS_TOP_BAR_LOGO 102
#define IDR_VIEWTRIOUS_ABOUT_LOGO 103
#define IDI_VIEWTRIOUS_VIDEO 104
#define IDI_VIEWTRIOUS_3D 105

IDI_VIEWTRIOUS ICON "Viewtrious.ico"
IDI_VIEWTRIOUS_VIDEO ICON "ViewtriousVideo.ico"
IDI_VIEWTRIOUS_3D ICON "Viewtrious3D.ico"
IDR_VIEWTRIOUS_TOP_BAR_LOGO RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/ViewtriousLogoRuntime.png"
IDR_VIEWTRIOUS_ABOUT_LOGO RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/ViewtriousLogo.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_COMMAS@
 PRODUCTVERSION @PROJECT_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Viewtrious"
            VALUE "FileDescription", "Viewtrious"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Viewtrious"
            VALUE "OriginalFilename", "Viewtrious.exe"
            VALUE "ProductName", "Viewtrious"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END


